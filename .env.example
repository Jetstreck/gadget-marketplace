PORT=8080
ENV=development

# Database configuration (PostgreSQL or SQLite fallback)
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gadget_marketplace
DB_SSLMODE=disable

# JWT Secret
JWT_SECRET=supersecretjwtkey_gadget_marketplace_2026
JWT_EXPIRATION_HOURS=24

# External API
DUMMYJSON_URL=https://dummyjson.com

# Email SMTP Provider (Mailjet / Mailtrap / Inboxes)
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_USER=your_mailjet_api_key
SMTP_PASSWORD=your_mailjet_secret_key
SENDER_EMAIL=no-reply@gadgetmarketplace.com
